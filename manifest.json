{
  "manifest_version": 3,
  "name": "comdot",
  "version": "2.4.0",
  "description": "Navigate using top-down domain structures.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dnsv69@zshivan",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "strict_min_version": "58.0"
    }
  }
}